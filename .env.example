# DiddiFree Pilotage staging environment
POSTGRES_DB=pilotage
POSTGRES_USER=pilotage
POSTGRES_PASSWORD=change-me

PILOTAGE_OIDC_JWKS_URL=https://auth-staging.diddifree.com/identity/v1/.well-known/jwks.json
PILOTAGE_OIDC_ISSUER=https://auth-staging.diddifree.com/identity/v1
PILOTAGE_OIDC_AUDIENCE=
PILOTAGE_CORS_ORIGINS=https://supervision.diddifree.com
PILOTAGE_SERVE_FRONTEND=0
PILOTAGE_TRUSTED_SERVICE_SUBJECTS=service:odoo
PILOTAGE_BOOTSTRAP_DG_EMAILS=

# Shared S2S client per the internal integration guide (client_id = pilotage-staging)
PILOTAGE_SERVICE_CLIENT_ID=pilotage-staging
PILOTAGE_SERVICE_CLIENT_SECRET=

# Collection
PILOTAGE_MODULES=identity,diddigo,diddisend,diddipay
# Add diddifood after its dedicated staging client secret is installed.
PILOTAGE_COLLECT_INTERVAL_SECONDS=30
PILOTAGE_FRESHNESS_WINDOW_SECONDS=60
PILOTAGE_BUSINESS_TIMEZONE=Africa/Abidjan

# Per-module overrides (all optional):
# PILOTAGE_DIDDIGO_SERVICE_TOKEN=            static token during migration only
# PILOTAGE_DIDDIGO_SERVICE_CLIENT_ID=        per-module client if not using the shared one
# PILOTAGE_DIDDIGO_SERVICE_CLIENT_SECRET=
# PILOTAGE_DIDDIGO_SERVICE_AUDIENCE=         defaults to the module key
# PILOTAGE_DIDDIGO_SCOPE=                    defaults to <module>:pilotage-summary:read
# PILOTAGE_DIDDIGO_SUMMARY_BASE=             defaults to /internal/pilotage (diddipay: /payfund/v1/internal/pilotage)
# PILOTAGE_DIDDIGO_DAILY_SUMMARY_PATH=        overrides the complete daily route
# PILOTAGE_DIDDISEND_FINANCE_SCOPE=diddisend:pilotage:finance-summary:read
# PILOTAGE_DIDDIGO_BREAKDOWN_SCOPE=diddigo:ride-summary:read
# PILOTAGE_DIDDISEND_BREAKDOWN_SCOPE=delivery-summary:read

# Identity reporting uses a dedicated audience and a non-standard daily path.
# PILOTAGE_IDENTITY_SERVICE_CLIENT_ID=
# PILOTAGE_IDENTITY_SERVICE_CLIENT_SECRET=
# PILOTAGE_IDENTITY_SERVICE_AUDIENCE=diddifree-id
# PILOTAGE_IDENTITY_SCOPE=identity:reporting:read
# PILOTAGE_IDENTITY_DAILY_SUMMARY_PATH=/internal/pilotage/identity-summary
